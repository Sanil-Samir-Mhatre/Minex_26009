# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml and replace with your actual keys.
# NEVER commit the actual secrets.toml to GitHub!

# Application access key (optional password gate)
API_KEY = "your_secret_api_key_here"
API_KEY_HASH = ""

# Google Maps Platform Javascript API Key (for 3D maps and terrain overlays)
GOOGLE_MAPS_API_KEY = "AIzaSyYourGoogleMapsApiKeyHere"
